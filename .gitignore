# Personal state. The bar rewrites these; they contain notification text,
# cookies, queue history and other private data that must never be pushed.
home/.config/quickshell/database.json
home/.local/state/
home/.cache/
*.log
*.sock
*.socket
*.sqlite
*.sqlite3
*.db

# Credentials and secrets. Keep them out of the public backup even by accident.
*.cookie
*cookies*.txt
*password*
*passwd*
*token*
*secret*
*.key
*.pem
*.p12
id_rsa*
id_ed25519*
known_hosts
.netrc
.authinfo
.env
.env.*
auth.json

