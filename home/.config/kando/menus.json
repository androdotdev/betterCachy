{
  "version": "3.0.1",
  "menus": [
    {
      "root": {
        "name": "Example Menu",
        "icon": "award_star",
        "iconTheme": "material-symbols-rounded",
        "type": "root",
        "activateWorkflow": {
          "quickSelectKey": "Escape",
          "actions": [
            {
              "type": "close-menu"
            }
          ]
        },
        "children": [
          {
            "name": "Apps",
            "icon": "apps",
            "iconTheme": "material-symbols-rounded",
            "type": "submenu",
            "openWorkflow": {
              "quickSelectKey": "A",
              "actions": []
            },
            "activateWorkflow": {
              "quickSelectKey": "Backspace",
              "actions": [
                {
                  "type": "close-submenu"
                }
              ]
            },
            "children": [
              {
                "name": "Clipboard",
                "icon": "assignment",
                "iconTheme": "material-symbols-rounded",
                "type": "submenu",
                "openWorkflow": {
                  "quickSelectKey": "V",
                  "actions": []
                },
                "activateWorkflow": {
                  "quickSelectKey": "Backspace",
                  "actions": [
                    {
                      "type": "simulate-hotkey",
                      "hotkey": "MetaLeft+KeyV"
                    }
                  ]
                },
                "children": [
                  {
                    "name": "Paste",
                    "icon": "content_paste_go",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "angle": 90,
                    "selectWorkflow": {
                      "quickSelectKey": "V",
                      "actions": [
                        {
                          "type": "close-menu"
                        },
                        {
                          "type": "simulate-hotkey",
                          "hotkey": "ControlLeft+KeyV"
                        }
                      ]
                    }
                  },
                  {
                    "name": "Copy",
                    "icon": "content_copy",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": {
                      "quickSelectKey": "C",
                      "actions": [
                        {
                          "type": "close-menu"
                        },
                        {
                          "type": "simulate-hotkey",
                          "hotkey": "ControlLeft+KeyC"
                        }
                      ]
                    }
                  },
                  {
                    "name": "Cut",
                    "icon": "cut",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": {
                      "quickSelectKey": "X",
                      "actions": [
                        {
                          "type": "close-menu"
                        },
                        {
                          "type": "simulate-hotkey",
                          "hotkey": "ControlLeft+KeyX"
                        }
                      ]
                    }
                  },
                  {
                    "name": "Next Workspace",
                    "icon": "arrow_forward",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": {
                      "quickSelectKey": "N",
                      "actions": [
                        {
                          "type": "simulate-hotkey",
                          "hotkey": "ControlLeft+AltLeft+ArrowRight"
                        },
                        {
                          "type": "close-menu"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "name": "Helium Browser",
            "icon": "helium-browser",
            "iconTheme": "system",
            "type": "button",
            "selectWorkflow": {
              "quickSelectKey": "W",
              "actions": [
                {
                  "type": "execute-command",
                  "command": "helium-browser",
                  "detached": true,
                  "isolated": false
                },
                {
                  "type": "close-menu"
                }
              ]
            }
          },
          {
            "name": "PhotoGIMP",
            "icon": "photogimp",
            "iconTheme": "system",
            "type": "button",
            "selectWorkflow": {
              "quickSelectKey": "G",
              "actions": [
                {
                  "type": "execute-command",
                  "command": "flatpak run --branch=stable --command=gimp --file-forwarding org.gimp.GIMP @@u  @@",
                  "detached": true,
                  "isolated": false
                },
                {
                  "type": "close-menu"
                }
              ]
            }
          },
          {
            "name": "kitty",
            "icon": "kitty",
            "iconTheme": "system",
            "type": "button",
            "selectWorkflow": {
              "quickSelectKey": "T",
              "actions": [
                {
                  "type": "execute-command",
                  "command": "kitty",
                  "detached": true,
                  "isolated": false
                },
                {
                  "type": "close-menu"
                }
              ]
            }
          },
          {
            "name": "Dolphin",
            "icon": "org.kde.dolphin",
            "iconTheme": "system",
            "type": "button",
            "selectWorkflow": {
              "quickSelectKey": "F",
              "actions": [
                {
                  "type": "execute-command",
                  "command": "dolphin",
                  "detached": true,
                  "isolated": false
                },
                {
                  "type": "close-menu"
                }
              ]
            }
          }
        ]
      },
      "shortcut": "Control+Space",
      "shortcutID": "example-menu",
      "useFixedPosition": false,
      "fixedMenuPosition": {
        "x": 0.5,
        "y": 0.5
      },
      "anchored": false,
      "hoverMode": false,
      "tags": []
    }
  ],
  "collections": [
    {
      "name": "Favorites",
      "icon": "favorite",
      "iconTheme": "material-symbols-rounded",
      "tags": [
        "favs"
      ]
    },
    {
      "name": "New Collection",
      "icon": "sell",
      "iconTheme": "material-symbols-rounded",
      "tags": []
    }
  ]
}
