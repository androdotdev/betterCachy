// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "escape_key_behavior": "close_window",
   "global_shortcuts": {
      "toggle": "super+SPACE"
   },
   "launcher_window": {
      "compact_mode": {
         "enabled": true
      }
   },
   "favorites": [],
   "providers": {
      "ai": {
         "enabled": false
      },
      "browser-extension": {
         "enabled": false
      },
      "calculator": {
         "enabled": false
      },
      "clipboard": {
         "preferences": {
            "monitoring": true,
            "ignorePasswords": false,
            "preserveTagged": true,
            "ignoredApps": [],
            "evictionThreshold": "never",
            "eraseOnStartup": false
         },
         "entrypoints": {
            "clear": {
               "enabled": false
            },
            "clear-history": {
               "enabled": false
            },
            "history": {
               "shortcut": "super+V"
            }
         }
      },
      "core": {
         "enabled": false,
         "entrypoints": {
            "forget-telemetry": {
               "enabled": false
            },
            "inspect-local-storage": {
               "enabled": false
            },
            "list-extensions": {
               "enabled": false
            },
            "manage-fallback": {
               "enabled": false
            },
            "oauth-token-store": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": false
            },
            "open-default-config": {
               "enabled": false
            },
            "refresh-apps": {
               "enabled": false
            },
            "reload-scripts": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "search-builtin-icons": {
               "enabled": false
            },
            "search-emojis": {
               "enabled": true,
               "shortcut": "super+."
            },
            "search-tray": {
               "enabled": false
            },
            "settings": {
               "enabled": false
            },
            "show-logs": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            },
            "store": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "dictation": {
         "enabled": false
      },
      "font": {
         "enabled": false
      },
      "media": {
         "enabled": false
      },
      "power": {
         "enabled": false
      },
      "raycast-compat": {
         "enabled": false
      },
      "scripts": {
         "enabled": false
      },
      "shortcuts": {
         "enabled": false
      },
      "snippets": {
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      },
      "system": {
         "enabled": false
      },
      "theme": {
         "enabled": false
      },
      "wm": {
         "enabled": false
      }
   }
}